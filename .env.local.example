# Copied to `.env.local` by `cp .env.local.example .env.local` in the main
# worktree. Linked worktrees get their own `.env.local` from
# `pnpm setup:worktree`, so never copy credentials between worktrees by hand.

# -*********************************************************-
# Convex backend
# -*********************************************************-

# Written by `pnpm exec convex dev` the first time it selects a deployment.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Stored in the Convex deployment too (`pnpm exec convex env set ...`).
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_WEBHOOK_SECRET=

# -*********************************************************-
# Frontend
# -*********************************************************-

VITE_CONVEX_URI=
VITE_WORKOS_CLIENT_ID=
# Optional. Linked worktrees get a unique port from `pnpm setup:worktree`.
VITE_DEV_SERVER_PORT=
