{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "plugins": ["typescript", "react", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-unused-vars": [
      "warn",
      {
        "args": "all",
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["#modules/*/*", "#/*/*"],
            "message": "Import from the module public API instead, for example '#modules/organizations'."
          }
        ]
      }
    ],
    "import/no-cycle": [
      "error",
      {
        "ignoreTypes": true
      }
    ],
    "typescript/no-import-type-side-effects": "error",
    "react/exhaustive-deps": "warn",
    "effecttsgo/async-function": "off",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error"
  },
  "overrides": [
    {
      "files": ["**/*.config.ts"],
      "rules": {
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/process-env": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/convex/_generated/**",
    "**/confect/_generated/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/src/generated/**",
    "**/prisma/migrations/**",
    "legacy-apps/reservation-service/migrations/**",
    "scripts/**",
    ".agents/**",
    ".windsurf/**",
    ".claude/**",
    "legacy-packages/legacy-e2e/**"
  ]
}
