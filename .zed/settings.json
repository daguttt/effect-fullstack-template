{
  "lsp": {
    "typescript-ls": {
      "binary": {
        "path": "node_modules/@typescript/native/bin/tsc",
        "arguments": ["--lsp", "--stdio"]
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cn", "tw"],
        "experimental": {
          "configFile": {
            "packages/ui/src/index.css": [
              "packages/ui/src/**",
              "apps/frontend/src/**"
            ]
          },
          "classRegex": ["(?:tw|TW)`([^`]*)`"]
        }
      }
    }
  },
  "languages": {
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    },
    "TSX": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    },
    "JavaScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    },
    "JSX": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    }
  }
}
