{
  "name": "@repo/frontend",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "type": "module",
  "imports": {
    "#modules/*": "./src/modules/*/index.ts",
    "#routes/*": "./src/routes/*/index.ts",
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "pnpm -w exec oxlint apps/frontend",
    "lint:fix": "pnpm -w exec oxlint --fix apps/frontend",
    "format:check": "pnpm -w exec prettier --check \"apps/frontend/**/*.{ts,tsx,html,js,jsx,jsonc,json,astro,mdx}\"",
    "format:write": "pnpm -w exec prettier --write \"apps/frontend/**/*.{ts,tsx,html,js,jsx,jsonc,json,astro,mdx}\" --cache --cache-strategy content --cache-location apps/frontend/node_modules/.cache/prettier/format-write",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:frontend",
    "@base-ui/utils": "catalog:frontend",
    "@confect/core": "catalog:",
    "@confect/react": "catalog:",
    "@effect/atom-react": "catalog:",
    "@fontsource-variable/nunito-sans": "catalog:frontend",
    "@fontsource-variable/roboto": "catalog:frontend",
    "@repo/backend": "workspace:*",
    "@repo/ui": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "@tailwindcss/vite": "catalog:frontend",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-devtools": "1.167.2",
    "@uidotdev/usehooks": "2.4.1",
    "@workos-inc/authkit-js": "0.20.3",
    "@workos-inc/authkit-react": "0.16.2",
    "class-variance-authority": "catalog:frontend",
    "clsx": "catalog:frontend",
    "convex": "catalog:",
    "effect": "catalog:",
    "lucide-react": "catalog:frontend",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "tailwind-merge": "catalog:frontend"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@convex-dev/workflow": "0.4.6",
    "@locator/babel-jsx": "0.5.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/react": "catalog:frontend",
    "@types/babel__core": "7.20.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:frontend",
    "babel-plugin-react-compiler": "catalog:frontend",
    "dotenv-expand": "13.0.0",
    "jsdom": "catalog:frontend",
    "oxlint": "catalog:",
    "shadcn": "catalog:frontend",
    "tailwindcss": "catalog:frontend",
    "tw-animate-css": "catalog:frontend",
    "typescript": "catalog:",
    "vite": "catalog:frontend",
    "vitest": "catalog:"
  }
}
