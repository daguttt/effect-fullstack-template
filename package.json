{
  "name": "@repo/root",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=12.5.1 <13"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "confect:codegen": "WORKOS_CLIENT_ID=client_id WORKOS_API_KEY=api_key WORKOS_WEBHOOK_SECRET=webhook confect codegen",
    "confect:dev": "WORKOS_CLIENT_ID=client_id WORKOS_API_KEY=api_key WORKOS_WEBHOOK_SECRET=webhook confect dev",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "feedback": "pnpm format:check; pnpm lint; pnpm typecheck:all",
    "dev": "turbo run dev --filter=@repo/frontend... --filter=@repo/backend... --ui tui",
    "dev:agent": "turbo run dev --filter=@repo/frontend... --filter=@repo/backend... --ui stream",
    "dev:backend": "turbo run dev --filter=@repo/backend... --ui tui",
    "dev:backend:agent": "turbo run dev --filter=@repo/backend... --ui stream",
    "dev:ui": "pnpm -F @repo/ui dev:start",
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=@repo/backend",
    "build:frontend": "turbo run build --filter=@repo/frontend",
    "lint": "oxlint --config .oxlintrc.typed.json --type-aware --type-check apps/frontend packages/backend packages/scripts packages/ui",
    "lint:fix": "oxlint --config .oxlintrc.typed.json --type-aware --type-check --fix apps/frontend packages/backend packages/scripts packages/ui",
    "typecheck:all": "turbo run typecheck",
    "typecheck:frontend": "turbo run typecheck --filter=@repo/frontend",
    "typecheck:backend": "turbo run typecheck --filter=@repo/backend",
    "env:copy": "pnpm -F @repo/scripts env:copy",
    "bootstrap:main": "pnpm install && ./packages/scripts/bin/bootstrap-main.sh",
    "setup:worktree": "pnpm install && pnpm -F @repo/scripts exec tsx src/worktree/setup.ts",
    "teardown:worktree": "pnpm -F @repo/scripts exec tsx src/worktree/teardown.ts",
    "vercel:env:update": "pnpm -F @repo/scripts vercel:env:update",
    "format:write:all": "prettier --write \"**/*.{ts,tsx,html,js,jsx,jsonc,json,mdx}\" --cache --cache-strategy content --cache-location node_modules/.cache/prettier/format-write-all",
    "format:check:all": "prettier --check \"**/*.{ts,tsx,html,js,jsx,jsonc,json,mdx}\"",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "test:all": "turbo run test --ui tui",
    "test:run:all": "turbo run test:run",
    "test:backend": "turbo run test:run --filter=@repo/backend",
    "test:frontend": "turbo run test:run --filter=@repo/frontend"
  },
  "devDependencies": {
    "@confect/cli": "catalog:",
    "@confect/core": "catalog:",
    "@confect/server": "catalog:",
    "@effect/tsgo": "catalog:",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@typescript/native": "catalog:",
    "convex": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.12",
    "typescript": "catalog:"
  }
}
