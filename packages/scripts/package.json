{
  "name": "@repo/scripts",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "type": "module",
  "scripts": {
    "env:copy": "./bin/copy-main-worktree-env-files.sh",
    "vercel:env:update": "tsx src/update-vercel-env.ts",
    "worktree:setup": "tsx src/worktree/setup.ts",
    "worktree:teardown": "tsx src/worktree/teardown.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm -w exec oxlint packages/scripts",
    "lint:fix": "pnpm -w exec oxlint --fix packages/scripts",
    "format:check": "pnpm -w exec prettier --check \"packages/scripts/**/*.{ts,tsx,html,js,jsx,jsonc,json,astro,mdx}\"",
    "format:write": "pnpm -w exec prettier --write \"packages/scripts/**/*.{ts,tsx,html,js,jsx,jsonc,json,astro,mdx}\" --cache --cache-strategy content --cache-location packages/scripts/node_modules/.cache/prettier/format-write"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
